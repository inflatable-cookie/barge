# barged as a systemd *user* unit, so an rpm-ostree desktop needs no layered package.
#
# Install (docs/install-barged.md):
#   ~/.local/bin/barged and ~/.config/barged/config.json exist
#   cp packaging/barged/barged.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now barged
[Unit]
Description=Barge machine daemon (barged)
Documentation=file:%h/.config/barged/config.json
After=network-online.target
# System tailscaled is outside this user unit; Restart=on-failure retries startup.
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/barged --config %h/.config/barged/config.json
Restart=on-failure
RestartSec=5s

# The daemon answers HTTP on one address and calls logind. It needs nothing
# else: no shell, no writable system paths, no new privileges.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The one writable place: paired clients, the machine ID and the state lock
# live beside the config.
ReadWritePaths=%h/.config/barged
StateDirectory=barged
ReadWritePaths=-%h/.config/barged
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK lets getifaddrs read the bound interface's MAC and broadcast
# address, which the state reports so clients can wake the machine.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
